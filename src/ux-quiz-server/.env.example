# Токен бота из @BotFather. Пусто — dev-режим: без Telegram, оплата имитируется, вход по заголовку `dev <userId>`.
BOT_TOKEN=
# true — бот на тестовом сервере Telegram (бесплатные Stars).
BOT_TEST_ENV=false
# Порт HTTP-сервера.
PORT=8787
# Файл базы SQLite.
DB_PATH=./ux-quiz.db
# Откуда разрешены запросы Mini App (через запятую). Пусто — любой origin (только для разработки).
CORS_ORIGINS=http://localhost:5179
# Ссылка на Mini App для кнопки в боте: https://t.me/<bot>/<app>
APP_LINK=https://t.me/ux_quiz_bot/play
# Как получать обновления бота: polling (локально) или webhook (на хостинге).
BOT_UPDATES=polling
# Секрет вебхука (заголовок X-Telegram-Bot-Api-Secret-Token) и вызова /cron/tick. Обязателен для webhook.
WEBHOOK_SECRET=
# Твой Telegram id (узнать: @userinfobot). Сюда приходят обращения /paysupport; тебе доступны /reply и /refund.
ADMIN_ID=
# Публичный адрес игры, https://<домен> — для ссылок на условия и политику.
PUBLIC_URL=
